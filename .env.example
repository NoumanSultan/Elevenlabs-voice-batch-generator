# ── ElevenLabs ──────────────────────────────────────────────────────────────
# Fallback credentials used when the user leaves the API Key / Voice ID
# fields blank in the UI. Get your key at https://elevenlabs.io/app/settings/api-keys
# and your voice's ID from https://elevenlabs.io/app/voice-library (or Voices tab).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Optional password gate ──────────────────────────────────────────────────
# If set, visitors must enter this password before using the app.
# Leave blank to disable authentication entirely.
APP_PASSWORD=

# Used to sign the login session cookie. Any long random string works.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=
